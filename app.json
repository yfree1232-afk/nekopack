{
  "name": "CatUserBot",
  "description": "A modular Telegram userbot based on Telethon.",
  "keywords": [
    "telegram",
    "userbot",
    "telethon",
    "catuserbot"
  ],
  "website": "https://github.com/TgCatUB/CatUserbot",
  "repository": "https://github.com/yfree1232-afk/nekopack",
  "env": {
    "API_ID": {
      "description": "Get this from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Get this from my.telegram.org",
      "required": true
    },
    "ALIVE_NAME": {
      "description": "Your custom alive name.",
      "required": false,
      "value": "Neko"
    },
    "STRING_SESSION": {
      "description": "Your Telethon / Pyrogram String Session.",
      "required": true
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql"
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
